---
import { messages, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollImage from '../ScrollImage.astro';
import { projects } from '../../data/site';
import { findImage, projectSizes } from '../../lib/images';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = messages[locale];

const projectImages = await Promise.all(projects.map((project) => findImage('projects', project.imageStem)));
---

<BaseLayout locale={locale} title={copy.projects + " — CastorRise"} description={copy.projectsIntro}>
  <div class="page-shell">
    <section class="page-intro" aria-labelledby="page-title"><p class="eyebrow">{copy.projectsKicker}</p><h1 id="page-title">{copy.projects}</h1><p>{copy.projectsIntro}</p></section>
    <div class="project-list">
      {projects.map((project, index) => (
        <article class="project-entry" id={project.slug}>
          <div class="project-entry-media">
            {projectImages[index] ? <ScrollImage image={projectImages[index]} sizes={projectSizes} alt={`${project.title} — ${copy.projectCover}`} /> : <div class="image-placeholder image-placeholder-project" aria-hidden="true"><span>{project.slug === 'class-schedule-to-calendar' ? 'PDF → ICS' : project.title}</span><small>{project.slug === 'class-schedule-to-calendar' ? copy.timetable : copy.projectImageSoon}</small></div>}
          </div>
          <div class="project-entry-copy"><span class="eyebrow">{copy.project} / {String(index + 1).padStart(3, '0')}</span><h2>{project.title}</h2><p>{project.description[locale]}</p><a class="project-link" href={project.repository} target="_blank" rel="noopener noreferrer">{copy.viewRepository} <span aria-hidden="true">↗</span></a></div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
