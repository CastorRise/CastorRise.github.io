---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScrollImage from '../ScrollImage.astro';
import ImageCaptionMeta from '../ImageCaptionMeta.astro';
import { categories } from '../../data/site';
import { getGalleryImages, gallerySizes, coverSizes } from '../../lib/images';
import { messages, localizedPath, type Locale } from '../../i18n';
import type { Category } from '../../data/site';
import { illustrationReleaseDates, illustrationPublishDates } from '../../data/releases';
import { getImageDescription } from '../../data/image-descriptions';
import { isImageVisible, releaseTime } from '../../lib/release-schedule';


interface Props { locale?: Locale; category: Category; }
const { locale = 'en', category } = Astro.props;
const copy = messages[locale];
const categoryCopy = copy.categories[category.slug];
const url = (path: string) => localizedPath(locale, path);
const nextCategory = categories[categories.findIndex((item) => item.slug === category.slug) + 1];
const images = await getGalleryImages(category.slug);
const isWideImage = (image: (typeof images)[number]) =>
  (category.slug === 'photography' || category.slug === 'weather') && image.aspectRatio > 16 / 9;
const orderedImages = [...images.filter(isWideImage), ...images.filter((image) => !isWideImage(image))]
  .map((image) => ({ ...image, description: getImageDescription(category.slug, image.stem, locale) }));
const upcomingImages = category.slug === 'illustration' ? await getGalleryImages('illustration/coming-soon') : [];
const isVisible = (stem: string) => category.slug !== 'illustration' || isImageVisible(stem, illustrationPublishDates);
const hasPublishedImages = images.some((image) => isVisible(image.stem));
---

<BaseLayout locale={locale} title={`${categoryCopy.title} — CastorRise`} description={`${categoryCopy.description} — CastorRise.`}>
  <div class="page-shell gallery-page">
    <section class="page-intro" aria-labelledby="page-title">
      <a class="breadcrumb" href={url("/works")}><span aria-hidden="true">←</span> {copy.allWorks}</a>
      <p class="eyebrow">{copy.archive} / {categoryCopy.kicker}</p>
      <h1 id="page-title">{categoryCopy.title}</h1>
      <p>{categoryCopy.description}</p>
    </section>
    {category.slug === 'illustration' && (
      <section class="upcoming-section" aria-labelledby="coming-soon-title">
        <div class="collection-heading">
          <h2 id="coming-soon-title">Coming Soon</h2>
          <p>{copy.comingSoonDescription}</p>
        </div>
        <div class="gallery upcoming-grid" data-category="illustration" data-upcoming-illustrations>
          {upcomingImages.map((image) => (
            <figure class="gallery-item">
              <ScrollImage {image} sizes={gallerySizes} alt={`${copy.upcomingWork} — ${image.name}`} />
              <figcaption>
                {releaseTime(illustrationReleaseDates[image.stem]) !== null ? <time datetime={illustrationReleaseDates[image.stem]}>{illustrationReleaseDates[image.stem].replaceAll('-', '.')}</time> : <span>{copy.releaseDatePending}</span>}
                <ImageCaptionMeta folder="illustration/coming-soon" stem={image.stem} name={image.name} {locale} />
              </figcaption>
            </figure>
          ))}
          <div class="upcoming-placeholder" data-upcoming-empty hidden={upcomingImages.length > 0}><span>Coming Soon</span><p>{copy.upcomingWork}</p></div>
        </div>
      </section>
    )}
    {category.slug === 'illustration' && <div class="collection-heading"><h2>{copy.publishedWorks}</h2></div>}
    {(hasPublishedImages || category.slug === 'illustration') && (
      <div class="gallery" data-category={category.slug} data-published-illustrations={category.slug === 'illustration' ? '' : undefined} hidden={!hasPublishedImages} aria-label={`${categoryCopy.title} — ${copy.gallery}`}>
        {orderedImages.map((image, index) => (
          <figure class:list={['gallery-item', { 'gallery-item-wide': isWideImage(image) }]} hidden={!isVisible(image.stem)}
            data-scheduled-release={category.slug === 'illustration' && Object.hasOwn(illustrationPublishDates, image.stem) ? image.stem : undefined}
            data-release-date={category.slug === 'illustration' && releaseTime(illustrationPublishDates[image.stem]) !== null ? illustrationPublishDates[image.stem] : undefined}>
            <ScrollImage {image} sizes={isWideImage(image) ? coverSizes : gallerySizes} alt={`${categoryCopy.title} — ${copy.work} ${index + 1}`} />
            <figcaption><span class="image-description">{image.description}</span><ImageCaptionMeta folder={category.slug} stem={image.stem} name={image.name} {locale} /></figcaption>
          </figure>
        ))}
      </div>
    )}
    <div class="gallery-empty" data-published-empty hidden={hasPublishedImages}><div class="gallery-empty-mark" aria-hidden="true">{categoryCopy.title.slice(0, 1)}</div><p>{categoryCopy.title}</p><span>{copy.worksSoon}</span></div>
    <div class="next-collection">
      <a class="eyebrow" href={url('/')}>{copy.continueExploring}</a>
      <a href={url(nextCategory ? `/works/${nextCategory.slug}` : '/')}>{nextCategory ? copy.nextCollection : copy.lastCollection} <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</BaseLayout>

<script>
  import { isReleaseDue, releaseTime } from '../../lib/release-schedule';

  const published = document.querySelector<HTMLElement>('[data-published-illustrations]');
  if (published) {
    let timer: ReturnType<typeof setTimeout> | undefined;
    function updateReleases() {
      clearTimeout(timer);
      const now = Date.now();
      const pending = Array.from(published!.querySelectorAll<HTMLElement>('[data-scheduled-release][hidden]'));
      const due = pending.filter((card) => isReleaseDue(card.dataset.releaseDate, now));
      if (due.length) {
        for (const card of due) card.hidden = false;
        published!.hidden = false;
        document.querySelector<HTMLElement>('[data-published-empty]')!.hidden = true;
        window.dispatchEvent(new Event('gallery:updated'));
      }
      const futureTimes = pending.map((card) => releaseTime(card.dataset.releaseDate)).filter((time): time is number => time !== null && time > now);
      if (futureTimes.length) timer = setTimeout(updateReleases, Math.min(60000, Math.max(1, Math.min(...futureTimes) - Date.now())));
    }
    updateReleases();
    window.addEventListener('pageshow', updateReleases);
    window.addEventListener('focus', updateReleases);
    document.addEventListener('visibilitychange', updateReleases);
  }
</script>
