---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { categories } from '../../data/site';
import { getGalleryImages } from '../../lib/images';
import { messages, localizedPath, type Locale } from '../../i18n';
import type { Category } from '../../data/site';


interface Props { locale?: Locale; category: Category; }
const { locale = 'en', category } = Astro.props;
const copy = messages[locale];
const categoryCopy = copy.categories[category.slug];
const url = (path: string) => localizedPath(locale, path);
const images = await getGalleryImages(category.slug);
const upcomingImages = category.slug === 'illustration' ? await getGalleryImages('illustration/coming-soon') : [];
---

<BaseLayout locale={locale} title={`${categoryCopy.title} — CastorRise`} description={`${categoryCopy.description} — CastorRise.`}>
  <div class="page-shell gallery-page">
    <section class="page-intro" aria-labelledby="page-title">
      <a class="breadcrumb" href={url("/works")}><span aria-hidden="true">←</span> {copy.allWorks}</a>
      <p class="eyebrow">{copy.archive} / {categoryCopy.kicker}</p>
      <h1 id="page-title">{categoryCopy.title}<span class="heading-period">.</span></h1>
      <p>{categoryCopy.description}</p>
    </section>
    {category.slug === 'illustration' && (
      <section class="upcoming-section" aria-labelledby="coming-soon-title">
        <div class="collection-heading">
          <h2 id="coming-soon-title">Coming Soon<span class="heading-period">.</span></h2>
          <p>{copy.comingSoonDescription}</p>
        </div>
        <div class="gallery upcoming-grid" data-category="illustration">
          {upcomingImages.length > 0 ? upcomingImages.map((image, index) => (
            <figure class="gallery-item">
              <img src={image.src} width={image.width} height={image.height} alt={`${copy.upcomingWork} ${index + 1}`} loading="lazy" decoding="async" />
              <figcaption><span>Coming Soon</span><span>{image.name}</span></figcaption>
            </figure>
          )) : (
            <div class="upcoming-placeholder"><span>Coming Soon</span><p>{copy.upcomingWork}</p></div>
          )}
        </div>
      </section>
    )}
    {category.slug === 'illustration' && <div class="collection-heading"><h2>{copy.publishedWorks}</h2></div>}
    {images.length > 0 ? (
      <div class="gallery" data-category={category.slug} aria-label={`${categoryCopy.title} — ${copy.gallery}`}>
        {images.map((image, index) => (
          <figure class="gallery-item">
            <img src={image.src} width={image.width} height={image.height} alt={`${categoryCopy.title} — ${copy.work} ${index + 1}`} loading="lazy" decoding="async" />
            <figcaption><span>0{index + 1}</span><span>{image.name}</span></figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <div class="gallery-empty"><div class="gallery-empty-mark" aria-hidden="true">{categoryCopy.title.slice(0, 1)}</div><p>{categoryCopy.title}</p><span>{copy.worksSoon}</span></div>
    )}
    <div class="next-collection"><span class="eyebrow">{copy.continueExploring}</span><a href={url(`/works/${categories[(categories.findIndex((item) => item.slug === category.slug) + 1) % categories.length].slug}`)}>{copy.nextCollection} <span aria-hidden="true">↗</span></a></div>
  </div>
</BaseLayout>
