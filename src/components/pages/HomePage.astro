---
import { messages, localizedPath, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../WorkCard.astro';
import { categories, projects } from '../../data/site';
import { findImage, createPreview, projectSizes } from '../../lib/images';
import type { ImageMetadata } from 'astro';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = messages[locale];
const url = (path: string) => localizedPath(locale, path);

const heroSources = import.meta.glob<ImageMetadata>('/public/images/hero/*.{jpg,jpeg,webp,avif,png,JPG,JPEG,WEBP,AVIF,PNG}', { eager: true, import: 'default' });
const heroImages = await Promise.all(Object.entries(heroSources)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([path, image]) => createPreview(image, path.split('/').pop()!)));
const heroPanels = heroImages.length ? heroImages.slice(0, 3) : [null, null, null];
const workImages = await Promise.all(categories.map((category) => findImage(category.slug, category.imageStem)));
const projectImages = await Promise.all(projects.map((project) => findImage('projects', project.imageStem)));
---

<BaseLayout locale={locale} home>
  <section class="hero" style={`--hero-count: ${heroPanels.length}`} data-hero-images={JSON.stringify(heroImages)} aria-labelledby="hero-title">
    <div class="hero-visuals" aria-hidden="true">
      {heroPanels.map((image, index) => <div class:list={['hero-panel', { 'hero-panel-placeholder': !image }]}>
        {image && <>
          <img class="hero-image" data-hero-image width={image.width} height={image.height} alt="" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
          <noscript><img class="hero-image" src={image.src} srcset={image.srcset} sizes={`max(100vw, ${100 * image.width / image.height}vh)`} width={image.width} height={image.height} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></noscript>
        </>}
        <span class="hero-panel-index">{String(index + 1).padStart(2, '0')} / {String(heroPanels.length).padStart(2, '0')}</span>
      </div>)}
      <script is:inline>
        const hero = document.currentScript.closest('[data-hero-images]');
        const images = JSON.parse(hero.dataset.heroImages);
        // Shuffle once per page load, then use three distinct photos in the scroll panels.
        for (let i = images.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [images[i], images[j]] = [images[j], images[i]];
        }
        hero.querySelectorAll('[data-hero-image]').forEach((element, index) => {
          const image = images[index];
          element.width = image.width;
          element.height = image.height;
          element.sizes = `max(100vw, ${100 * image.width / image.height}vh)`;
          element.srcset = image.srcset;
          element.src = image.src;
        });
      </script>
    </div>
    <div class="hero-stage">
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="hero-overline">{copy.heroOverline}</p>
        <h1 id="hero-title">CastorRise</h1>
        <p class="hero-subtitle">{copy.create} <span>·</span> {copy.observe} <span>·</span> {copy.explore}</p>
        <p class="hero-disciplines">{copy.disciplines}</p>
      </div>
      <a class="scroll-cue" href="#selected-works" aria-label={copy.scrollLabel}><span class="scroll-cue-line" aria-hidden="true"></span><span>{copy.scroll}</span></a>
    </div>
  </section>

  <section class="section selected-works" id="selected-works" aria-label={copy.works}>
    <div class="works-grid">
      {categories.map((category, index) => <WorkCard category={category} locale={locale} image={workImages[index]} index={index} />)}
    </div>
    <div class="works-browse"><a class="text-link" href={url("/works")}>{copy.exploreWorks} <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section projects-section" aria-labelledby="projects-title">
    <div class="section-heading">
      <div><p class="eyebrow">02 / {copy.experiments}</p><h2 id="projects-title">{copy.projects}</h2></div>
      <a class="text-link" href={url("/projects")}>{copy.viewProjects} <span aria-hidden="true">↗</span></a>
    </div>
    <div class="project-list">
    {projects.map((project, index) => <a class="feature-project" href={url("/projects") + '#' + project.slug} aria-label={copy.viewProject + " — " + project.title}>
      <div class="feature-project-image">
        {projectImages[index] ? <img src={projectImages[index].src} srcset={projectImages[index].srcset} sizes={projectSizes} width={projectImages[index].width} height={projectImages[index].height} alt={project.title + " — " + copy.projectCover} loading="lazy" decoding="async" /> : <div class="image-placeholder image-placeholder-project" aria-hidden="true"><span>{project.slug === 'class-schedule-to-calendar' ? 'PDF → ICS' : project.title}</span><small>{project.slug === 'class-schedule-to-calendar' ? copy.timetable : copy.projectImageSoon}</small></div>}
      </div>
      <div class="feature-project-copy"><span class="eyebrow">{copy.project} / {String(index + 1).padStart(3, '0')}</span><div><h3>{project.title}</h3><p>{project.description[locale]}</p></div><span class="project-link">{copy.viewProject} <span aria-hidden="true">↗</span></span></div>
    </a>)}
    </div>
  </section>

  <section class="home-closing" aria-label={copy.closing}>
    <p>{copy.quoteFirst}<br />{copy.quoteLast}</p>
    <span>{copy.closingText}</span>
  </section>
</BaseLayout>
