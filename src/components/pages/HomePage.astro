---
import { messages, localizedPath, type Locale } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../WorkCard.astro';
import ScrollImage from '../ScrollImage.astro';
import { categories } from '../../data/site';
import { getProjects } from '../../lib/projects';
import { findImage, createPreview, projectSizes } from '../../lib/images';
import type { ImageMetadata } from 'astro';

interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = messages[locale];
const url = (path: string) => localizedPath(locale, path);

const heroSources = import.meta.glob<ImageMetadata>('/public/images/hero/*.{jpg,jpeg,webp,avif,png,JPG,JPEG,WEBP,AVIF,PNG}', { eager: true, import: 'default' });
const heroImages = await Promise.all(Object.entries(heroSources)
  .sort(([a], [b]) => a.localeCompare(b, 'en', { numeric: true }))
  .map(([path, image]) => createPreview(image, path.split('/').pop()!)));
const heroPanels = heroImages.length ? heroImages.slice(0, 3) : [null, null, null];
const workImages = await Promise.all(categories.map((category) => findImage(category.slug, category.imageStem)));
const featuredProject = getProjects()[0];
const projectImage = await findImage('projects', featuredProject.imageStem);
---

<BaseLayout locale={locale} home>
  <section class="hero" style={`--hero-count: ${heroPanels.length}`} data-hero-images={JSON.stringify(heroImages)} aria-labelledby="hero-title">
    <div class="hero-visuals" aria-hidden="true">
      {heroPanels.map((image, index) => <div class:list={['hero-panel', { 'hero-panel-placeholder': !image }]}>
        {image && <>
          <img class="hero-image" data-hero-image width={image.width} height={image.height} alt="" loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
          <noscript><img class="hero-image" src={image.src} srcset={image.srcset} sizes={`max(100vw, ${100 * image.width / image.height}vh)`} width={image.width} height={image.height} alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></noscript>
        </>}
        <span class="hero-panel-index">{String(index + 1).padStart(2, '0')} / {String(heroPanels.length).padStart(2, '0')}</span>
      </div>)}
      <script is:inline>
        const hero = document.currentScript.closest('[data-hero-images]');
        // Embedded mobile browsers can expose a layout viewport taller than the visible page.
        const syncHeroViewport = () => {
          hero.style.setProperty('--hero-viewport-height', `${window.visualViewport?.height ?? window.innerHeight}px`);
        };
        syncHeroViewport();
        window.addEventListener('resize', syncHeroViewport);
        window.visualViewport?.addEventListener('resize', syncHeroViewport);
        const images = JSON.parse(hero.dataset.heroImages);
        // Shuffle once per page load, then use three distinct photos in the scroll panels.
        for (let i = images.length - 1; i > 0; i--) {
          const j = Math.floor(Math.random() * (i + 1));
          [images[i], images[j]] = [images[j], images[i]];
        }
        hero.querySelectorAll('[data-hero-image]').forEach((element, index) => {
          const image = images[index];
          element.width = image.width;
          element.height = image.height;
          element.sizes = `max(100vw, ${100 * image.width / image.height}vh)`;
          if (index === 0) {
            element.srcset = image.srcset;
            element.src = image.src;
          } else {
            element.dataset.deferredImage = '';
            element.dataset.srcset = image.srcset;
            element.dataset.src = image.src;
          }
        });
      </script>
    </div>
    <div class="hero-stage">
      <div class="hero-scrim" aria-hidden="true"></div>
      <div class="hero-content">
        <p class="hero-overline">{copy.heroOverline}</p>
        <h1 id="hero-title">CastorRise</h1>
        <p class="hero-subtitle">{copy.create} <span>·</span> {copy.observe} <span>·</span> {copy.explore}</p>
        <p class="hero-disciplines">{copy.disciplines}</p>
      </div>
      <a class="scroll-cue" href="#selected-works" aria-label={copy.scrollLabel}><span class="scroll-cue-line" aria-hidden="true"></span><span>{copy.scroll}</span></a>
    </div>
  </section>

  <section class="section selected-works" id="selected-works" aria-label={copy.works}>
    <div class="works-grid">
      {categories.map((category, index) => <WorkCard category={category} locale={locale} image={workImages[index]} index={index} />)}
    </div>
    <div class="works-browse"><a class="text-link" href={url("/works")}>{copy.exploreWorks} <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section projects-section" aria-labelledby="projects-title">
    <a class="work-card" href={url("/projects")} aria-label={copy.viewProjects}>
      <div class="work-card-caption">
        <div><span class="eyebrow">02 / {copy.experiments}</span><h2 id="projects-title">{copy.projects}</h2></div>
        <span class="caption-arrow" aria-hidden="true">↗</span>
      </div>
      <div class="feature-project">
        <div class="feature-project-image">
          {projectImage ? <ScrollImage image={projectImage} sizes={projectSizes} alt={featuredProject.title + " — " + copy.projectCover} /> : <div class="image-placeholder image-placeholder-project" aria-hidden="true"><span>{featuredProject.title}</span><small>{copy.projectImageSoon}</small></div>}
        </div>
        <div class="feature-project-copy">
          <span class="eyebrow">{copy.project} / 001</span>
          <div><h3>{featuredProject.title}</h3><p>{featuredProject.description[locale]}</p></div>
          <span class="project-link">{copy.viewProjects} <span aria-hidden="true">↗</span></span>
        </div>
      </div>
    </a>
  </section>

  <section class="home-closing" aria-label={copy.closing}>
    <p>{copy.quoteFirst}<br />{copy.quoteLast}</p>
    <span>{copy.closingText}</span>
  </section>
</BaseLayout>

<script>
  const hero = document.querySelector<HTMLElement>('.hero');
  const stage = hero?.querySelector<HTMLElement>('.hero-stage');

  if (hero && stage) {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let previousScrollY = window.scrollY;
    let scrollingDown = true;
    let frame = 0;
    let lastProgress = 0;
    let offset = 0;
    let anchorProgress = 0;
    let anchorOffset = 0;

    function update() {
      frame = 0;
      const stageHeight = stage!.offsetHeight;
      const end = hero!.offsetHeight - stageHeight;
      const distance = Math.min(240, stageHeight * .24);
      const travelled = -hero!.getBoundingClientRect().top;
      const progress = Math.max(0, Math.min(1, (travelled - end + distance) / distance));
      const nextDirection = window.scrollY === previousScrollY ? scrollingDown : window.scrollY > previousScrollY;
      if (nextDirection !== scrollingDown) {
        // Start each direction change at the last rendered position, never at an unrelated curve value.
        anchorProgress = lastProgress;
        anchorOffset = offset;
        scrollingDown = nextDirection;
      }
      previousScrollY = window.scrollY;
      const lift = Math.min(36, stageHeight * .045);

      if (reducedMotion.matches || progress === 0) {
        offset = anchorOffset = anchorProgress = 0;
      } else if (progress === 1) {
        offset = anchorOffset = -lift;
        anchorProgress = 1;
      } else if (scrollingDown) {
        const remaining = 1 - anchorProgress;
        const fraction = remaining > 0 ? Math.max(0, Math.min(1, (progress - anchorProgress) / remaining)) : 1;
        const eased = 1 - Math.pow(1 - fraction, 3);
        offset = anchorOffset + (-lift - anchorOffset) * eased;
      } else {
        // Upward scrolling is linear, while preserving continuity with the downward ease-out.
        const fraction = anchorProgress > 0 ? Math.max(0, Math.min(1, progress / anchorProgress)) : 0;
        offset = anchorOffset * fraction;
      }
      lastProgress = progress;
      // Both the copy and scroll cue inherit this value; there is no time-based motion after scrolling stops.
      stage!.style.setProperty('--hero-copy-offset', `${offset}px`);
    }

    function scheduleUpdate() {
      if (frame) return;
      frame = requestAnimationFrame(update);
    }

    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    window.visualViewport?.addEventListener('resize', scheduleUpdate);
    reducedMotion.addEventListener('change', scheduleUpdate);
  }
</script>
