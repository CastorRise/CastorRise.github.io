---
import ScrollImage from './ScrollImage.astro';
import ImageCaptionMeta from './ImageCaptionMeta.astro';
import { gallerySizes, type LocalImage } from '../lib/images';
import { releaseTime } from '../lib/release-schedule';
import { illustrationReleaseDates } from '../data/releases';
import { getImageDescription } from '../data/image-descriptions';
import { messages, type Locale } from '../i18n';

interface Props { image: LocalImage; locale: Locale; released: boolean; }
const { image, locale, released } = Astro.props;
const copy = messages[locale];
const date = illustrationReleaseDates[image.stem];
const validDate = releaseTime(date) !== null;
const publishedAlt = `${copy.categories.illustration.title} — ${image.name}`;
---

<figure class="gallery-item" data-scheduled-release={image.stem} data-release-date={validDate ? date : undefined} data-release-state={released ? 'released' : 'upcoming'} data-published-alt={publishedAlt}>
  <ScrollImage {image} sizes={gallerySizes} alt={released ? publishedAlt : `${copy.upcomingWork} — ${image.name}`} />
  <figcaption data-upcoming-caption hidden={released}>
    {validDate ? <time datetime={date}>{date.replaceAll('-', '.')}</time> : <span>{copy.releaseDatePending}</span>}
    <ImageCaptionMeta folder="illustration/coming-soon" stem={image.stem} name={image.name} {locale} />
  </figcaption>
  <figcaption data-published-caption hidden={!released}>
    <span class="image-description">{getImageDescription('illustration', image.stem, locale)}</span>
    <ImageCaptionMeta folder="illustration/coming-soon" stem={image.stem} name={image.name} {locale} />
  </figcaption>
</figure>
