---
import { messages, type Locale } from '../i18n';
interface Props { locale?: Locale; }
const { locale = 'en' } = Astro.props;
const copy = messages[locale];
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-identity">
      <span>© 2026 CastorRise</span>
    </div>
    <div class="footer-links">
      <a href="mailto:castorrise@outlook.com">castorrise@outlook.com</a>
      <a href="https://github.com/CastorRise" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://www.pixiv.net/users/90100684" target="_blank" rel="noopener noreferrer">Pixiv <span aria-hidden="true">↗</span></a>
      <a href="https://www.instagram.com/castorrise" target="_blank" rel="noopener noreferrer">Instagram <span aria-hidden="true">↗</span></a>
      <a href="https://www.threads.com/@castorrise" target="_blank" rel="noopener noreferrer">Threads <span aria-hidden="true">↗</span></a>
      <a href="#top">{copy.top} <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>
